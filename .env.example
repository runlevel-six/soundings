# Soundings - Environment Variables
# Copy this file to .env and fill in your values.
# Usage: export $(grep -v '^#' .env | xargs)

# Team roster
# Preferred: a JSON file mapping each person to their per-source usernames.
# See team.example.json. team.json is gitignored. Defaults to ./team.json.
DEVOPS_METRICS_TEAM_FILE=./team.json
# Fallback (used only when the team file above does not exist): a simple
# comma-separated list where each username is treated as one person.
DEVOPS_METRICS_TEAM_USERNAMES=user1,user2,user3,user4,user5

# --- Gitea ---
GITEA_BASE_URL=https://git.example.com
GITEA_TOKEN=your-gitea-token
GITEA_ORG_NAME=your-org

# --- GitHub (optional - collector is skipped if GITHUB_ORG is not set) ---
# Used while a select set of apps lives in GitHub; merged into unified git totals.
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=your-github-token
GITHUB_ORG=your-org

# --- Jenkins ---
# Name your instances however you like: a comma-separated list of labels, then
# one URL per label. A label with no URL set is skipped.
JENKINS_INSTANCES=dev,prod
JENKINS_DEV_URL=https://jenkins.dev.example.com
JENKINS_PROD_URL=https://jenkins.prod.example.com

# Shared credentials, used for any instance without an override.
JENKINS_USERNAME=your-jenkins-username
JENKINS_PASSWORD=your-jenkins-password
# Optional per-instance overrides: JENKINS_<LABEL>_USERNAME / _PASSWORD
#JENKINS_PROD_USERNAME=a-different-user
#JENKINS_PROD_PASSWORD=a-different-password

# --- ArgoCD (one token per instance) ---
ARGOCD_INSTANCES=dev,prod
ARGOCD_DEV_URL=https://argocd.dev.example.com
ARGOCD_DEV_TOKEN=your-argocd-dev-token

ARGOCD_PROD_URL=https://argocd.prod.example.com
ARGOCD_PROD_TOKEN=your-argocd-prod-token

# --- Jira ---
JIRA_CSV_PATH=./jira_export.csv
JIRA_PROJECT_KEY=PROJ

# --- ZenDesk (optional - collector is skipped if ZENDESK_SUBDOMAIN is not set) ---
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=admin@example.com
ZENDESK_API_TOKEN=your-zendesk-api-token
ZENDESK_EMAIL_DOMAIN=example.com

# --- OpsGenie (optional - collector is skipped if OPSGENIE_API_KEY is not set) ---
# Needs an API key with read access to alerts and alert logs.
OPSGENIE_API_KEY=your-opsgenie-api-key
# This is the REST API host, NOT the web portal you log in to. The portal
# (e.g. yourorg.app.opsgenie.com) does not serve the API. Use
# https://api.eu.opsgenie.com for EU-hosted accounts.
OPSGENIE_API_URL=https://api.opsgenie.com
# Used to expand bare roster usernames into OpsGenie usernames when they are
# emails. Defaults to ZENDESK_EMAIL_DOMAIN when unset.
OPSGENIE_EMAIL_DOMAIN=example.com

# Fallback timezone for after-hours/weekend alert buckets, used for anyone whose
# team.json entry has no "timezone". IANA name -- note the singular "America/"
# prefix ("Americas/New_York" is not a real zone). Set this to where most of the
# team sits and override the exceptions per person in team.json; leaving it at
# UTC will misclassify a US team by 4-6 hours.
DEVOPS_METRICS_DEFAULT_TIMEZONE=America/New_York

# Working day, in each person's local time, as HH:MM-HH:MM on a 24-hour clock.
# The start is inclusive and the end exclusive, so 09:00-18:00 counts an 18:00
# page as after-hours. Weekends are always weekend regardless of this window.
DEVOPS_METRICS_BUSINESS_HOURS=09:00-18:00
