#!/bin/sh
#
# Refuse to push a commit that names a real person.
#
# Scans every commit being pushed, not just the branch tip. A name deleted in a
# later commit is still readable in the earlier one, and rewriting history after
# the fact does not help: the forge keeps the orphaned commit reachable by SHA
# long after the branch has moved on. The only cheap moment to catch this is
# before the first push.
#
# Enable it once per clone:
#
#     git config core.hooksPath .githooks
#
set -u

root=$(git rev-parse --show-toplevel)
scanner="$root/tools/scan_identifiers.py"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue           # branch deletion

    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha"                           # new branch: every commit
    else
        range="$remote_sha..$local_sha"
    fi

    for commit in $(git rev-list "$range"); do
        python3 "$scanner" --rev "$commit" --quiet || status=1
    done
done

if [ "$status" -ne 0 ]; then
    echo >&2
    echo "pre-push: the commits above still name real people. Push aborted." >&2
    echo "Fix every commit listed, not just the tip — an amended-away name" >&2
    echo "stays readable on the forge at its original SHA." >&2
fi

exit $status
